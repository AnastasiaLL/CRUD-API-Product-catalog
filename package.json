{
  "name": "crud-api-product-catalog",
  "version": "1.0.0",
  "description": "CRUD API for Product Catalog using Fastify",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "npm run build && node dist/main.js",
    "build": "tsc",
    "start:multi": "node dist/cluster.js",
    "test": "jest --config jest.config.cjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^4.25.0",
    "@fastify/cors": "^9.0.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.8",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
